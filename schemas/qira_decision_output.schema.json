    "decision_context_id",
    "instrument_id",
    "decision",
    "gross_ev_bps",
    "net_ev_bps",
    "risk_adjusted_ev_bps",
    "gate_status",
    "gate_reasons",
    "gate_reason_details",
    "explanation",
    "proof_limits",
    "trace_receipt",
    "ev_units",
    "ev_horizon",
    "data_version",
    "model_version",
    "output_contract_version",
    "claim_boundary_policy"
